# Caché (Cloudflare Pages). Por defecto todo salía con max-age=14400 (4 h).

# JS y CSS del build: el nombre lleva hash, así que nunca cambia de contenido.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Videos, secuencias y fotos: nombre fijo; si se reemplaza un archivo, cambiarle
# el nombre (como se hizo con que-podemos-hacer.mp4). Un día de caché.
/assets/*
  Cache-Control: public, max-age=86400
/logos/*
  Cache-Control: public, max-age=86400
